APP_PORT=3000
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Garage S3 API endpoint untuk upload, bukan URL publik gambar.
S3_ENDPOINT=
# Harus sesuai s3_region di konfigurasi Garage.
S3_REGION=garage
S3_BUCKET=cdn.didul.site
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

S3_PUBLIC_BASE_URL=
