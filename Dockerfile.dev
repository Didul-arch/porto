FROM node:24-bookworm-slim

WORKDIR /app
ENV CI=true
RUN npm install --global pnpm@11.17.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --store-dir /pnpm/store

COPY . .

ENV NODE_ENV=development
EXPOSE 3000

# Sinkronkan dependency volume saat container dimulai ulang.
CMD ["sh", "-c", "pnpm install --frozen-lockfile --store-dir /pnpm/store && exec pnpm run dev --host 0.0.0.0 --port 3000 --strictPort"]
