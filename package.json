{
	"name": "my-porto-gw",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"db:migrate": "node-pg-migrate up --migrations-dir src/db/migrations"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/pg": "^8.23.1",
		"node-pg-migrate": "^9.0.0",
		"sass-embedded": "^1.107.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"@tiptap/core": "^3.33.1",
		"@tiptap/extension-code-block-lowlight": "^3.33.1",
		"@tiptap/html": "^3.33.1",
		"@tiptap/pm": "^3.33.1",
		"@tiptap/starter-kit": "^3.33.1",
		"hast-util-to-html": "^9.0.6",
		"lowlight": "^3.3.0",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
